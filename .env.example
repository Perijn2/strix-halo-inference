# Author: Perijn
# Summary: Supplies deployment-specific paths, resource limits, and credentials for Docker Compose.
# Usage: Copy this file to .env, replace every path and credential, then start the complete Compose stack.
MODELS_DIR=/srv/ai/models
HALOGEN_MODELS_DIR=/srv/ai/models/halogen-qwen3.8-flash-next
# Complete Ciru release checkout. Run its runtime/INSTALL-ORNITH-RUNTIME.sh once
# so this directory also contains installed-runtime/ before starting Compose.
ORNITH_MODEL_DIR=/srv/ai/models/ornith1.5-ciru-halo-agent
POSTGRES_PASSWORD_FILE=/srv/ai/secrets/postgres_password

# Use localhost for local access or the server LAN IP/DNS name for Caddy internal TLS.
CADDY_SITE=localhost
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
# Numeric host group IDs for /dev/dri access. The generator discovers both values.
RENDER_GID=
VIDEO_GID=

POSTGRES_DB=inference
POSTGRES_USER=inference
HALOGEN_HOST_RESERVE_GIB=28

# OCR defaults are deliberately CPU-first: gfx1151 has no validated upstream ROCm
# path for the Python/Paddle runtimes. The service code supports vLLM only after
# you rebuild it from a TheRock-compatible image and measure coexistence with Qwen.
OCR_DEVICE=cpu
OCR_MINERU_BACKEND=transformers
OCR_VLLM_GPU_MEMORY_UTILIZATION=0.35
OCR_PADDLE_LANGUAGE=en
OCR_TESSERACT_LANGUAGE=eng

# Strict OCR allocation: these defaults sum to 12 GiB. The Surya SDK client is
# separate because its Pillow requirement conflicts with MinerU's. Increase none
# of these values until you measure every Qwen/Ornith/retrieval model loaded.
OCR_ENSEMBLE_MEMORY_LIMIT_GIB=6
OCR_SURYA_CLIENT_MEMORY_LIMIT_GIB=2
OCR_SURYA_MEMORY_LIMIT_GIB=4

# Starting points only: tune using held-out scans with human labels. A page that
# fires a review verdict must not be automatically accepted after threshold tuning.
OCR_AGREE_THRESHOLD=0.92
OCR_CLASSICAL_PAIR_AGREE=0.90
OCR_CLASSICAL_PAIR_HARD=0.75
OCR_ENTROPY_ACCEPT_MAX=0.25
OCR_ENTROPY_REVIEW_FLOOR=0.60

# Original uploads and rendered pages are retained on Docker's ocr_audit_data
# volume for this period. PostgreSQL stores the audit ledger and review queue.
OCR_AUDIT_RETENTION_DAYS=90