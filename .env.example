# Author: Perijn
# Summary: Supplies deployment-specific paths and credentials for Docker Compose.
# Usage: Copy this file to .env, replace every path and credential, then start the required Compose profile.
MODELS_DIR=/srv/ai/models
HALOGEN_MODELS_DIR=/srv/ai/models/halogen-qwen3.8-flash-next
POSTGRES_PASSWORD_FILE=/srv/ai/secrets/postgres_password

# Use localhost for local TLS or a public DNS name for ACME certificates.
CADDY_SITE=localhost
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
CADDY_API_USER=inference
# Docker Compose requires literal dollar signs in bcrypt hashes to be escaped.
# Run scripts/generate-secrets.sh to replace this development value.
CADDY_API_PASSWORD_HASH=$$2a$$14$$286cL8X5mQVQZeL7F458n.bzY1j1CYHlNfeenFs7Qrrkhmd1rQdWO

# Numeric host group IDs for /dev/dri access. The generator discovers both values.
RENDER_GID=
VIDEO_GID=

POSTGRES_DB=inference
POSTGRES_USER=inference
HALOGEN_HOST_RESERVE_GIB=28
