# Author: Perijn
# Summary: Forwards every public inference request to llama-swap without application-level authentication.
# Usage: Restrict network access with a host firewall or private network before exposing this listener.
# Explicit HTTP catch-all: LAN IP requests commonly carry Host: <server-ip>, not localhost.
http:// {

	log {
		output stdout
		format console
	}

	request_body {
		max_size 32MB
	}

	handle {
		reverse_proxy llama-swap:8080 {
			flush_interval -1
			health_uri /health
		}
	}
}
